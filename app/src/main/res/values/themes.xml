<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MySplashScreen" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FF6900</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splashscreen</item>
        <item name="postSplashScreenTheme">@style/Theme.ApplicationHome</item>
    </style>

    <style name="Theme.ApplicationHome" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/lightBackgroundForCards</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>